class Solution {
    public void merge(int[] nums1, int m, int[] nums2, int n) {
        int left = m-1; // ending pointer
        int right = 0; // starting 

        while(left >= 0 && right < n){
            if(nums1[left] > nums2[right]){
                int temp = nums1[left];
                nums1[left] = nums2[right];
                nums2[right] = temp;
                left--;
                right++;
            }
            else {
                break;
            }
        }

        // now sort both 
        Arrays.sort(nums1 , 0 , m);
        Arrays.sort(nums2);

        for(int i = m; i < m + n; i++){
            nums1[i] = nums2[i - m];
        }
    }
}
