class Solution {
    public void sortZeroOneTwo(int[] nums) {
        int cnt_0 = 0;
        int cnt_1 = 0;
        int cnt_2 = 0;

        for(int i = 0; i < nums.length; i++){
            if(nums[i] == 0){
                cnt_0++;
            }
            else if(nums[i] == 1){
                cnt_1++;
            }
            else {
                cnt_2++;
            }
        }

        for(int i = 0; i < cnt_0; i++) nums[i] = 0;
        for(int i = cnt_0; i < cnt_0 + cnt_1; i++) nums[i] = 1;
        for(int i = cnt_0 + cnt_1; i < nums.length; i++) nums[i] = 2;

    }
}


// dutch optimal 
class Solution {
    private void swap( int nums [] , int a , int b){
        int temp = nums[a];
        nums[a] = nums[b];
        nums[b] = temp;
    }
    public void sortZeroOneTwo(int[] nums) {
        int low = 0;
        int mid = 0;
        int high = nums.length -1;

        while( mid <= high){
            if(nums[mid] == 0){
                swap(nums , low , mid);
                low++;
                mid++;
            }
            else if(nums[mid] == 1){
                mid++;
            }
            else {
                swap(nums, mid , high);
                high--;
            }
        }
    }
}
Q. Find the repeating and missing number

public class Solution {

    public static int[] missingAndRepeating(ArrayList<Integer> arr, int n) {
        // Write your code here
        int missing = -1;
        int repeat = -1;

        for(int i = 1; i <= n; i++){
            int cnt = 0;
            for(int j = 0; j < n; j++){
                if(arr.get(j) == i){
                    cnt++;
                }
            }

            if(cnt == 2) repeat = i;
            if(cnt == 0) missing = i;

            if(repeat != -1 && missing != -1){
                break;
            } 
        }
        return  new int[] {missing , repeat};
    }
}

