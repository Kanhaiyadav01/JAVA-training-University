class Solution {
    public int[] rearrangeArray(int[] nums) {
        int n = nums.length;
        int[] arr = new int[n];

        int positive = 0;
        int negative = 1;

        for(int i = 0; i < n; i++) {
            if(nums[i] < 0) {
                arr[negative] = nums[i];
                negative = negative + 2;
            } else {
                arr[positive] = nums[i];
                positive = positive + 2;
            }
        }
        return arr;
    }
}

