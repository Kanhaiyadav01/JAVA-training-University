class Solution {
    public int maxProduct(int[] nums) {
        int n = nums.length;
        int leftProduct = 1;
        int rightProduct = 1;

        int maxProduct = nums[0];

        for(int i = 0; i < n; i++) {    

            leftProduct = leftProduct == 0 ? 1 : leftProduct;
            rightProduct = rightProduct == 0 ? 1 : rightProduct;
            // prefixproduct
            leftProduct = leftProduct * nums[i];
            // sufficproduct
            rightProduct = rightProduct * nums[n - i - 1];
            maxProduct = Math.max(maxProduct, Math.max(leftProduct, rightProduct));
        }
        return maxProduct;
    }
}

Leetcode 152 Merge Intervals 
Optimal
class Solution {
    public int[][] merge(int[][] intervals) {
        Arrays.sort(intervals, (a,b) -> Integer.compare(a[0], b[0]));

        List<int[]> merged = new ArrayList<>();

        int[] prev = intervals[0];

        for(int i = 1; i < intervals.length; i++) {
            int[] next = intervals[i];

            if(next[0] <= prev[1]) {
              prev[1] = Math.max(prev[1], next[1]);
            } else {
                merged.add(prev);
                prev = next;
            }
        }
        merged.add(prev);
        return merged.toArray(new int[merged.size()][]);
    }
}

Leetcode 42 
Trapping Rain water
Optimal 
class Solution {
    public int trap(int[] height) {
        int n = height.length;

        int[] left = new int[n];
        int[] right = new int[n];

        left[0] = height[0];
        for(int i = 1; i < n; i++) {
            left[i] = Math.max(left[i-1],height[i]);
        }
        right[n-1] = height[n-1];
        for(int i = n-2; i >= 0; i--) {
            right[i] = Math.max(right[i + 1], height[i]);
        }

        int waterLogged = 0;
        for(int i = 0; i < n; i++) {
            waterLogged += Math.min(left[i], right[i]) - height[i];
        }
        return waterLogged;
    }
}

Leetcode 2149
Reraaring array elements by sign 
Optimal 
class Solution {
    public int[] rearrangeArray(int[] nums) {
        int n = nums.length;
        int[] arr = new int[n];

        int positive = 0;
        int negative = 1;

        for(int i = 0; i < n; i++) {
            if(nums[i] < 0) {
                arr[negative] = nums[i];
                negative = negative + 2;
            } else {
                arr[positive] = nums[i];
                positive = positive + 2;
            }
        }
        return arr;
    }
}

229. Majority Element II
// optimal
class Solution {
    public List<Integer> majorityElement(int[] nums) {
        int n = nums.length;

        int ele1 = Integer.MIN_VALUE;
        int ele2 = Integer.MIN_VALUE;

        int cnt1 = 0;
        int cnt2 = 0;

        for(int i = 0; i < n; i++){
            if(cnt1 == 0 && ele2 != nums[i]){
                cnt1 = 1;
                ele1 = nums[i];
            }
            else if(cnt2 == 0 && ele1 != nums[i]){
                cnt2 = 1;
                ele2 = nums[i];
            }
            else if(nums[i] == ele1){
                cnt1++;
            }
            else if(nums[i] == ele2){
                cnt2++;
            }
            else {
                cnt1--;
                cnt2--;
            }
        }

        cnt1 = 0;
        cnt2 = 0;
        for(int i = 0; i < n; i++){
            if(nums[i] == ele1){
                cnt1++;
            }
            if(nums[i] == ele2){
                cnt2++;
            }
        }

        int min = n / 3 + 1;

        List<Integer> ans = new ArrayList<>();
        if(cnt1 >= min){
            ans.add(ele1);
        }
        if(cnt2 >= min && ele1 != ele2){
            ans.add(ele2);
        }

        return ans;
    }
}
