// 1 insertion
class Solution {
    public int[] insertionSort(int[] nums) {

        for(int i = 0; i <= nums.length-1; i++){

            int j = i;

            while(j > 0 && nums[j-1] > nums[j]){
                int temp = nums[j-1];
                nums[j-1] = nums[j];
                nums[j] = temp;

                j--;
            }
        }
        return nums;
    }
}

// 2 bubble sort
class Solution {
  public int[] bubbleSort(int[] nums) {
    int n = nums.length;

    for (int i = 0; i < n-1; i++) {

      boolean isSwapped = false;
      for (int j = 0; j < n - i - 1; j++) {

        if (nums[j] > nums[j + 1]) {
          int temp = nums[j];
          nums[j] = nums[j + 1];
          nums[j + 1] = temp;
          isSwapped = true;
        }
      }
      if (!isSwapped) {
        break;
      }
    }

    return nums;
  }
}

// 3 selection sort
class Solution {
    public int[] selectionSort(int[] nums) {

        for(int i = 0; i < nums.length-1; i++){
            
            int mini = i;

            for(int j = i+1; j < nums.length; j++){

                if(nums[j] < nums[mini]){
                mini = j;
                } // update mini
            }

            // swap only if i is chng
            if(mini != i){
                int temp = nums[i];
                nums[i] = nums[mini];
                nums[mini] = temp;
            }
        }

        return nums;

    }
}
