// 1 . Longest Consecutive Sequence in an Array
// better
class Solution {
    public int longestConsecutive(int[] nums) {
        int n = nums.length;

        Arrays.sort(nums);

        if(n == 0) return 0;

        int lstSmaller = Integer.MIN_VALUE;

        int cnt = 0;

        int longest = 1;

        for(int i = 0; i < n; i++){
            if(nums[i] - 1 == lstSmaller){
                cnt += 1;
                //update lstSmaller
                lstSmaller = nums[i];
            } // if doesn't exist reset 
            else if(nums[i] != lstSmaller){
                cnt = 1;
                lstSmaller = nums[i];
            }
            longest = Math.max(longest , cnt);
        }
        return longest;
    }
}

// brute
class Solution {

    private boolean linearSearch(int []nums ,int ele){
        int n = nums.length;
        for(int i = 0; i < n; i++){
            if(nums[i] == ele){
                return true;
            }
        }
        return false;
    }
    public int longestConsecutive(int[] nums) {
        
        int n = nums.length;
        int longest = 1;

        for(int i = 0; i < n; i++){
            int ele = nums[i];
            int cnt = 1;

            while(linearSearch(nums , ele + 1) == true){
                ele += 1;
                cnt += 1;
            }
            // update longest 
            longest = Math.max(longest , cnt);
        }
        return longest;
    }
}
