1 Search X in sorted array
class Solution {
    public int search(int[] nums, int target) {
       int left = 0;
       int right = nums.length -1;

       while(left <= right){
           // find mid 
         int mid = (left + right) / 2;
           // case 1 when mid = target
         if(nums[mid] == target) return mid;

         // case 2 when target> mid
         else if(nums[mid] < target){
            left = mid + 1;
          }
          else {
             right = mid - 1;
          }
       }
       return -1;
    }
}

// recursive 
class Solution {

    private int recFun(int nums[] , int low , int high , int target){
        // base case
        if(low > high) return -1;

        int idx;

        int mid = (low + high) / 2;

        // case 1 
        if(target == nums[mid]) idx = mid;

        // case 2 
        else if(target < nums[mid]){
            idx = recFun(nums , low , mid-1 , target);
        }
        // case 3 
        else {
            idx = recFun(nums , mid+1 , high , target);
        }

        return idx;
    }

    public int search(int[] nums, int target) {
       int n = nums.length;

       return recFun(nums , 0 , n-1 , target);
    }
}
